# Local receiver
HOST=127.0.0.1
PORT=3000
WEBHOOK_PATH=/mobilerun/replace-with-at-least-24-random-characters
WEBHOOK_SECRET=whsec_replace_with_the_one_time_secret
DOWNLOAD_DIR=./downloads

# mobilerun file API
MOBILERUN_BASE_URL=https://api.mobilerun.ai/v1
MOBILERUN_CLOUD_API_KEY=replace_with_your_api_key

# Optional limits
MAX_WEBHOOK_BODY_BYTES=65536
MAX_FILE_BYTES=52428800
MAX_TIMESTAMP_AGE_SECONDS=300

# Optional live showcase UI (showcase.py)
PUBLIC_URL=https://replace-with-your-tunnel.ngrok.app
SHOWCASE_TRIGGER_ID=replace-with-your-custom-trigger-uuid
# SHOWCASE_ACCESS_TOKEN=replace-with-a-long-random-value
# SHOWCASE_PREVIEW_MAX_BYTES=100000
# SHOWCASE_DELETE_WEBHOOK_ON_EXIT=true

# To reuse an existing endpoint, set all three values together. When omitted,
# showcase.py creates a temporary endpoint and deletes it on shutdown.
# SHOWCASE_WEBHOOK_ID=replace-with-your-webhook-uuid
# SHOWCASE_WEBHOOK_PATH=/mobilerun/replace-with-at-least-24-random-characters
# SHOWCASE_WEBHOOK_SECRET=whsec_replace_with_the_one_time_secret
