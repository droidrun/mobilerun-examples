# Local receiver
HOST=127.0.0.1
PORT=3000
WEBHOOK_PATH=/mobilerun/replace-with-at-least-24-random-characters
WEBHOOK_SECRET=whsec_replace_with_the_one_time_secret
DOWNLOAD_DIR=./downloads

# mobilerun file API
MOBILERUN_BASE_URL=https://api.mobilerun.ai/v1
MOBILERUN_CLOUD_API_KEY=replace_with_your_api_key

# Optional limits
MAX_WEBHOOK_BODY_BYTES=65536
MAX_FILE_BYTES=52428800
MAX_TIMESTAMP_AGE_SECONDS=300
