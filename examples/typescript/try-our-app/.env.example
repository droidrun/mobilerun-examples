# Keep this secret on the server. It is never sent to the browser.
MOBILERUN_CLOUD_API_KEY=dr_sk_...

# Optional; defaults to https://api.mobilerun.ai/v1.
# MOBILERUN_API_URL=https://api.mobilerun.ai/v1

PORT=3000

# App the visitor is locked to (Android package name).
# DEMO_APP_PACKAGE=com.android.chrome

# How long one demo lasts, and how often expired demos are swept.
# SESSION_TTL_SECONDS=300
# REAPER_INTERVAL_SECONDS=15

# Hard cap on simultaneously running demo devices.
# MAX_CONCURRENT_SESSIONS=3

# Demo starts allowed per visitor (IP and anonymous cookie) per window.
# RATE_LIMIT_MAX=3
# RATE_LIMIT_WINDOW_SECONDS=3600

# Give up on a device that is not ready after this long.
# PROVISION_TIMEOUT_SECONDS=120

# Signs the anonymous visitor cookie. Random per start when unset.
# COOKIE_SECRET=change-me-to-a-long-random-string

# Where sessions are recorded so devices survive a server restart.
# SESSIONS_DB_PATH=data/sessions.sqlite

# Brand file mapped to the page look.
# BRAND_FILE=brand.json
