# Keep this secret on the server. It is never sent to the browser.
MOBILERUN_CLOUD_API_KEY=dr_sk_...

# Optional; defaults to https://api.mobilerun.ai/v1.
# MOBILERUN_API_URL=https://api.mobilerun.ai/v1

PORT=3000

# Signs the visitor cookie, at least 32 characters (openssl rand -hex 32). Left
# empty, the server makes a random one per process and cookies reset on
# restart. Required when NODE_ENV=production.
SESSION_SECRET=

# App the visitor is locked to (Android package name).
# DEMO_APP_PACKAGE=com.android.chrome

# How long one demo lasts, and how many phones may run at once.
# SESSION_TTL_SECONDS=300
# MAX_CONCURRENT_SESSIONS=3

# Demo starts allowed per visitor (IP and anonymous cookie) per hour.
# RATE_LIMIT_MAX=3
