{
  "name": "mobilerun-task-runner-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/server.ts --target=bun --root=. --outdir=dist",
    "check": "bun test && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@mobilerun/react": "^0.1.0",
    "@mobilerun/sdk": "^5.1.0",
    "hono": "^4.12.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
