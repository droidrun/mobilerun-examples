# Keep this secret on the server. It is never sent to the browser.
MOBILERUN_CLOUD_API_KEY=dr_sk_...

# Optional; defaults to https://api.mobilerun.ai/v1.
# MOBILERUN_API_URL=https://api.mobilerun.ai/v1

# Signs the stub session cookie: at least 32 characters, e.g. from
#   openssl rand -hex 32
# Empty in development means a random secret per process start (sessions reset
# on restart). Production requires it.
SESSION_SECRET=

# Comma-separated ids of the cloud phones this app may use (one run per phone).
DEVICE_IDS=

# The example's own credit ledger (whole credits). RESERVE_PER_RUN must cover
# the worst case of a run (maxSteps / executionTimeout in assistant.json): you
# pay any usage above it.
STARTING_BUDGET=100
RESERVE_PER_RUN=20

# SQLite file for the ledger.
DATABASE_PATH=data/ledger.sqlite

PORT=3000
