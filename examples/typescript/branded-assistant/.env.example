# Keep this secret on the server. It is never sent to the browser.
MOBILERUN_API_KEY=dr_sk_...

# Optional; defaults to https://api.mobilerun.ai/v1.
# MOBILERUN_API_URL=https://api.mobilerun.ai/v1

# Signs the stub session cookie. At least 32 characters; generate one with:
#   openssl rand -hex 32
# Without it, development generates a throwaway secret on every start.
SESSION_SECRET=dev-only-secret-replace-before-deploying

# Comma-separated ids of the cloud phones this app may use (one run per phone).
DEVICE_IDS=

# The example's own credit ledger (whole credits).
STARTING_BUDGET=100
RESERVE_PER_RUN=20

# SQLite file for the ledger.
DATABASE_PATH=data/ledger.sqlite

PORT=3000
