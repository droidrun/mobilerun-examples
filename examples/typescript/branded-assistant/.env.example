# Keep this secret on the server. It is never sent to the browser.
MOBILERUN_CLOUD_API_KEY=dr_sk_...

# Optional; defaults to https://api.mobilerun.ai/v1.
# MOBILERUN_API_URL=https://api.mobilerun.ai/v1

PORT=3000

# Signs the stub session cookie: at least 32 characters (openssl rand -hex 32).
# Empty in development means a random secret per start, so sessions reset on
# restart. Production requires it.
SESSION_SECRET=

# Comma-separated ids of the cloud phones this app may use (one run per phone).
DEVICE_IDS=

# The example's own credit ledger, in whole credits. RESERVE_PER_RUN must cover
# a run's worst case (maxSteps and executionTimeout in assistant.json): you pay
# any usage above it.
# STARTING_BUDGET=100
# RESERVE_PER_RUN=20

# SQLite file for accounts and runs.
# DATABASE_PATH=data/ledger.sqlite
