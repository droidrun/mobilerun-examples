# Keep this secret on the server. It is never sent to the browser.
MOBILERUN_API_KEY=dr_sk_...

# Optional; defaults to https://api.mobilerun.ai/v1.
# MOBILERUN_API_URL=https://api.mobilerun.ai/v1

# Signs the session cookie. At least 32 characters. Generate your own with:
#   openssl rand -hex 32
# The value below is for local development only; the server refuses it when
# NODE_ENV=production.
SESSION_SECRET=development-only-secret-change-me-before-deploying

# SQLite file for users and device ownership.
DATABASE_PATH=./data/portal.sqlite

# Devices one end user may own. This example's schema supports 0 or 1.
MAX_DEVICES_PER_USER=1

# Comma-separated emails that may open the admin overview.
ADMIN_EMAILS=admin@example.com

PORT=3000
