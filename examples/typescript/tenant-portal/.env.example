# Keep this secret on the server. It is never sent to the browser.
MOBILERUN_CLOUD_API_KEY=dr_sk_...

# Optional; defaults to https://api.mobilerun.ai/v1.
# MOBILERUN_API_URL=https://api.mobilerun.ai/v1

# Signs the session cookie, at least 32 characters. Generate one with:
#   openssl rand -hex 32
# Left empty, the server makes a random one per process (sessions reset on
# restart). Required when NODE_ENV=production.
SESSION_SECRET=

# SQLite file for users and device ownership.
DATABASE_PATH=./data/portal.sqlite

PORT=3000
